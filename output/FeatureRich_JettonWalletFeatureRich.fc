builder $JettonTransferInternalWithStateInit$_store(builder build_0, (int, int, slice, slice, int, tuple, slice) v) inline {
    var (v'queryId, v'amount, v'sender, v'responseDestination, v'forwardTonAmount, v'forwardStateInit, v'forwardPayload) = v;
    build_0 = store_uint(build_0, 395134233, 32);
